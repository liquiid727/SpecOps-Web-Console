{
  "name": "product-ai-os-cli-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "dev": "npm run dev:status",
    "dev:status": "tsx scripts/dev-status.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:tauri-client": "tsc -p tsconfig.server.json && vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run ui:check",
    "design:lint": "designmd lint DESIGN.md",
    "ui:check": "npm run design:lint && tsx scripts/check-ui-governance.ts",
    "start": "node dist-server/server/index.js",
    "smoke:real-cli": "tsx scripts/real-cli-smoke.ts",
    "test:e2e": "npm run build && zsh scripts/ego-browser-e2e.sh",
    "test:e2e:playwright": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@google/design.md": "0.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
