{
  "name": "@specos/cli",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "specos": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build --workspace @specos/core && tsc -p tsconfig.json && chmod +x dist/main.js",
    "test": "npm run build --workspace @specos/core && vitest run --root ../.. packages/cli/src"
  },
  "dependencies": {
    "@specos/core": "^0.2.0",
    "@specos/templates": "^0.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
