{
  "specId": "reward-order",
  "specVersion": "1.2.0",
  "changeId": "reward-order-ready",
  "featureName": "奖励订单发放",
  "source": "accepted-spec",
  "flows": [
    {
      "name": "奖励领取业务流",
      "stages": [
        {
          "name": "进入场景",
          "scenarioNames": [
            "用户成功领取奖励",
            "库存不足时领取失败"
          ],
          "stepNames": [
            "打开奖励页"
          ]
        },
        {
          "name": "触发动作",
          "scenarioNames": [
            "用户成功领取奖励",
            "库存不足时领取失败"
          ],
          "stepNames": [
            "点击领取"
          ]
        },
        {
          "name": "提交请求",
          "scenarioNames": [
            "用户成功领取奖励",
            "库存不足时领取失败"
          ],
          "stepNames": [
            "提交订单"
          ]
        },
        {
          "name": "确认结果",
          "scenarioNames": [
            "用户成功领取奖励",
            "库存不足时领取失败"
          ],
          "stepNames": [
            "查看结果",
            "查看失败提示"
          ]
        }
      ]
    }
  ],
  "endpoints": [
    {
      "name": "创建奖励订单",
      "method": "POST",
      "path": "/api/reward-orders",
      "priority": "P0",
      "branches": [
        "happy",
        "error",
        "limit",
        "flow"
      ],
      "preconditions": [
        "用户已登录",
        "奖励库存已同步"
      ],
      "expectedResults": [
        "创建成功返回订单号",
        "库存不足返回稳定错误码"
      ],
      "relatedRule": "reward.order.create"
    },
    {
      "name": "查询奖励订单",
      "method": "GET",
      "path": "/api/reward-orders/:id",
      "priority": "P1",
      "branches": [
        "happy",
        "error",
        "edge"
      ],
      "preconditions": [
        "订单号存在或不存在"
      ],
      "expectedResults": [
        "存在时返回详情",
        "无权限时拒绝访问"
      ],
      "relatedRule": "reward.order.read"
    }
  ],
  "scenarios": [
    {
      "name": "用户成功领取奖励",
      "priority": "P0",
      "branches": [
        "happy",
        "flow"
      ],
      "preconditions": [
        "奖励可领",
        "用户有资格"
      ],
      "expectedResults": [
        "订单创建成功",
        "发奖完成并可查询"
      ],
      "steps": [
        "打开奖励页",
        "点击领取",
        "提交订单",
        "查看结果"
      ]
    },
    {
      "name": "库存不足时领取失败",
      "priority": "P0",
      "branches": [
        "error",
        "limit"
      ],
      "preconditions": [
        "奖励库存为 0"
      ],
      "expectedResults": [
        "前端展示库存不足",
        "后端返回稳定错误码"
      ],
      "steps": [
        "打开奖励页",
        "点击领取",
        "提交订单",
        "查看失败提示"
      ]
    }
  ],
  "performanceTargets": [
    {
      "endpoint": "POST /api/reward-orders",
      "priority": "P0",
      "slo": {
        "p95Ms": 500,
        "p99Ms": 900,
        "errorRate": 0.01
      },
      "gateImpact": "blocking"
    },
    {
      "endpoint": "GET /api/reward-orders/:id",
      "priority": "P1",
      "slo": {
        "p95Ms": 300,
        "p99Ms": 700,
        "errorRate": 0.01
      },
      "gateImpact": "warning"
    }
  ],
  "concurrencyInvariants": [
    {
      "scenario": "库存不足时领取失败",
      "invariant": "库存不足时不能创建成功订单，重复提交必须保持同一业务结果",
      "actorProfile": "50 users submit reward claims at the same time",
      "expectedFinalState": "0 remaining inventory, 0 successful new orders, stable insufficient-stock response",
      "gateImpact": "blocking"
    }
  ],
  "releaseGates": [
    {
      "id": "reward-order-ready-gate",
      "type": "release",
      "requiredTestTypes": [
        "api",
        "scenario",
        "performance",
        "concurrency"
      ],
      "blocking": true,
      "evidenceRequired": [
        "trace",
        "raw-report"
      ]
    }
  ],
  "standardVersion": "specos-test-standard/v1",
  "qualityProfile": "fullstack-flow",
  "riskTier": "P0",
  "standardRequirements": [
    {
      "id": "std.p0.api.contract",
      "layer": "api",
      "appliesTo": [
        "POST /api/reward-orders",
        "GET /api/reward-orders/:id"
      ],
      "requiredFor": [
        "P0",
        "P1"
      ],
      "ownerAgent": "test-editor",
      "requiredEvidence": [
        "trace",
        "raw-report"
      ],
      "gateImpact": "blocking"
    },
    {
      "id": "std.p0.scenario.e2e",
      "layer": "scenario",
      "appliesTo": [
        "用户成功领取奖励",
        "库存不足时领取失败"
      ],
      "requiredFor": [
        "P0",
        "P1"
      ],
      "ownerAgent": "playwright-test-agent",
      "requiredEvidence": [
        "trace",
        "screenshot"
      ],
      "gateImpact": "blocking"
    },
    {
      "id": "std.p0.performance.slo",
      "layer": "performance",
      "appliesTo": [
        "POST /api/reward-orders"
      ],
      "requiredFor": [
        "P0"
      ],
      "ownerAgent": "performance-test-agent",
      "requiredEvidence": [
        "trace",
        "raw-report"
      ],
      "gateImpact": "blocking"
    },
    {
      "id": "std.p0.concurrency.invariant",
      "layer": "concurrency",
      "appliesTo": [
        "库存不足时领取失败"
      ],
      "requiredFor": [
        "P0"
      ],
      "ownerAgent": "concurrency-test-agent",
      "requiredEvidence": [
        "trace",
        "raw-report"
      ],
      "gateImpact": "blocking"
    },
    {
      "id": "std.p1.security.api",
      "layer": "security",
      "appliesTo": [
        "POST /api/reward-orders",
        "GET /api/reward-orders/:id"
      ],
      "requiredFor": [
        "P0",
        "P1"
      ],
      "ownerAgent": "test-editor",
      "requiredEvidence": [
        "trace",
        "raw-report"
      ],
      "gateImpact": "blocking"
    }
  ],
  "flakePolicy": {
    "allowedRetries": 1,
    "quarantineAllowed": false,
    "classificationRequired": true
  },
  "dataPolicy": {
    "seedCommand": "node scripts/orchestration/test-runner.mjs reward-order 1.2.0 ready",
    "cleanupCommand": "git clean -f tests/results/*.tmp.json",
    "externalDependencyMode": "stubbed",
    "piiAllowed": false,
    "secretsAllowed": false
  },
  "securityPolicy": {
    "baseline": "owasp-api-top-10-2023",
    "requiredChecks": [
      "broken-object-level-authorization",
      "broken-authentication",
      "broken-object-property-level-authorization",
      "unrestricted-resource-consumption"
    ]
  }
}
