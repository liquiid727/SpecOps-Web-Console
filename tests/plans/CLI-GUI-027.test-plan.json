  "featureName": "Session Model Providers",
  "source": "accepted-spec",
  "flows": [
    {
      "name": "Provider configuration and session launch",
      "stages": [
        { "name": "Provider CRUD", "scenarioNames": ["CLI-GUI-027 happy", "CLI-GUI-027 error", "CLI-GUI-027 migration", "CLI-GUI-027 flow"], "stepNames": ["Create or update a provider"] },
        { "name": "Protocol injection", "scenarioNames": ["CLI-GUI-027 happy", "CLI-GUI-027 limit", "CLI-GUI-027 security"], "stepNames": ["Launch isolated sessions with provider-specific inputs"] }
      ]
    }
  ],
  "endpoints": [
    { "name": "Provider summaries", "method": "GET", "path": "/api/providers", "priority": "P0", "branches": ["happy", "limit", "error", "flow"], "preconditions": ["Local application is running"], "expectedResults": ["Summaries omit credential values", "Empty providers remain valid"], "relatedRule": "provider.summary-is-secret-free" },
    { "name": "Create provider", "method": "POST", "path": "/api/providers", "priority": "P0", "branches": ["happy", "limit", "error", "flow"], "preconditions": ["Provider id is unique"], "expectedResults": ["Valid provider is persisted", "Invalid URL or protocol returns a stable validation error"], "relatedRule": "provider.validate-before-persist" }
  ],
  "scenarios": [
    { "name": "CLI-GUI-027 happy", "priority": "P0", "branches": ["happy", "flow"], "preconditions": ["A valid provider and credential reference exist"], "expectedResults": ["Protocol-specific launch inputs are isolated per session"], "steps": ["Create provider", "Start two sessions", "Inspect spawn inputs"] },
    { "name": "CLI-GUI-027 limit", "priority": "P0", "branches": ["limit"], "preconditions": ["Duplicate or invalid provider input"], "expectedResults": ["Validation rejects the input without state corruption"], "steps": ["Submit boundary input", "Inspect response and state"] },
    { "name": "CLI-GUI-027 error", "priority": "P0", "branches": ["error"], "preconditions": ["Credential is absent or protocol mismatches"], "expectedResults": ["Spawn is blocked before process creation"], "steps": ["Attempt launch", "Inspect typed error"] },
    { "name": "CLI-GUI-027 migration", "priority": "P0", "branches": ["error"], "preconditions": ["Schema v4 state is loaded"], "expectedResults": ["Provider defaults are added and malformed entries are discarded"], "steps": ["Load legacy state", "Inspect migrated state"] },
    { "name": "CLI-GUI-027 security", "priority": "P0", "branches": ["error"], "preconditions": ["Credential canary is configured"], "expectedResults": ["Canary does not appear in state, API, logs, or snapshots"], "steps": ["Run launch path", "Scan persisted and returned data"] }
  ],
  "standardRequirements": [
    { "id": "std.p0.unit.provider-contract", "layer": "unit", "appliesTo": ["Provider summaries"], "requiredFor": ["P0"], "ownerAgent": "unit-test-agent", "requiredEvidence": ["trace"], "gateImpact": "blocking" },
