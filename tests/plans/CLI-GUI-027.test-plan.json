    { "id": "std.p0.security.provider-secret", "layer": "security", "appliesTo": ["CLI-GUI-027 security"], "requiredFor": ["P0"], "ownerAgent": "test-editor", "requiredEvidence": ["raw-report"], "gateImpact": "blocking" },
    { "id": "std.p0.concurrency.provider-isolation", "layer": "concurrency", "appliesTo": ["CLI-GUI-027 happy"], "requiredFor": ["P0"], "ownerAgent": "concurrency-test-agent", "requiredEvidence": ["trace"], "gateImpact": "blocking" }
