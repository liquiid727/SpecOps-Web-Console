    { "name": "CLI-GUI-028 concurrency", "priority": "P0", "branches": ["flow"], "preconditions": ["Concurrent replacement and deletion are requested"], "expectedResults": ["One serialized final reference is authoritative"], "steps": ["Run concurrent mutations", "Inspect final state"] }
