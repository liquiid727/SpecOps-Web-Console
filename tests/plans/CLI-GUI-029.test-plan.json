    { "id": "std.p0.security.deployment-summary", "layer": "security", "appliesTo": ["CLI-GUI-029 security"], "requiredFor": ["P0"], "ownerAgent": "test-editor", "requiredEvidence": ["raw-report"], "gateImpact": "blocking" },
    { "id": "std.p0.compatibility.legacy-deployment", "layer": "compatibility", "appliesTo": ["CLI-GUI-029 happy"], "requiredFor": ["P0"], "ownerAgent": "specialized-check-agent", "requiredEvidence": ["trace"], "gateImpact": "blocking" }
  ],
