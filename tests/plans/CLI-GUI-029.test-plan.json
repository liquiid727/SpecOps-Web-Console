  "featureName": "Model Deployment Registry",
  "source": "accepted-spec",
  "flows": [
    {
      "name": "Deployment identity and eligibility",
      "stages": [
        { "name": "Deployment CRUD", "scenarioNames": ["CLI-GUI-029 happy", "CLI-GUI-029 limit", "CLI-GUI-029 error", "CLI-GUI-029 flow"], "stepNames": ["Create or update a deployment"] },
        { "name": "Eligibility snapshot", "scenarioNames": ["CLI-GUI-029 happy", "CLI-GUI-029 security"], "stepNames": ["Resolve a secret-free deployment summary"] }
      ]
    }
  ],
  "endpoints": [
    { "name": "Deployment summaries", "method": "GET", "path": "/api/model-deployments", "priority": "P0", "branches": ["happy", "limit", "error", "flow"], "preconditions": ["Provider and profile state can be loaded"], "expectedResults": ["Stable deployment identity and eligibility are returned", "Secrets are excluded"], "relatedRule": "deployment.identity-and-eligibility" },
    { "name": "Create deployment", "method": "POST", "path": "/api/model-deployments", "priority": "P0", "branches": ["happy", "limit", "error", "flow"], "preconditions": ["Provider, profile, and model references are supplied"], "expectedResults": ["Valid compatible references persist", "Unknown or incompatible references are rejected"], "relatedRule": "deployment.validate-references" }
  ],
  "scenarios": [
    { "name": "CLI-GUI-029 happy", "priority": "P0", "branches": ["happy", "flow"], "preconditions": ["Eligible provider/profile/model exist"], "expectedResults": ["Deployment summary is executable and stable"], "steps": ["Create deployment", "Resolve summary", "Inspect frozen identity"] },
    { "name": "CLI-GUI-029 limit", "priority": "P0", "branches": ["limit"], "preconditions": ["Disabled, archived, unavailable, or duplicate resources are supplied"], "expectedResults": ["Eligibility is deterministic and unknown is never eligible"], "steps": ["Resolve boundary resources", "Inspect exclusion codes"] },
    { "name": "CLI-GUI-029 error", "priority": "P0", "branches": ["error"], "preconditions": ["Reference or protocol is invalid"], "expectedResults": ["Validation rejects the operation without state loss"], "steps": ["Submit invalid deployment", "Inspect stable error"] },
    { "name": "CLI-GUI-029 migration", "priority": "P0", "branches": ["error"], "preconditions": ["Schema v6 state is loaded"], "expectedResults": ["Schema v7 defaults and backup behavior are deterministic"], "steps": ["Load legacy state", "Inspect migrated deployment data"] },
    { "name": "CLI-GUI-029 security", "priority": "P0", "branches": ["error"], "preconditions": ["Provider credential exists"], "expectedResults": ["Summary, history, and API payload contain no credential value"], "steps": ["Fetch deployment data", "Scan serialized output"] }
  ],
  "standardRequirements": [
    { "id": "std.p0.unit.deployment-domain", "layer": "unit", "appliesTo": ["Deployment summaries"], "requiredFor": ["P0"], "ownerAgent": "unit-test-agent", "requiredEvidence": ["trace"], "gateImpact": "blocking" },
