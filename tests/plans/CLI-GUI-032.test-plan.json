  "featureName": "Model Routing GUI and Recovery UX",
  "source": "accepted-spec",
  "flows": [
    {
      "name": "Routing configuration and recovery journey",
      "stages": [
        { "name": "Configure resources", "scenarioNames": ["CLI-GUI-032 happy", "CLI-GUI-032 limit", "CLI-GUI-032 error", "CLI-GUI-032 flow"], "stepNames": ["Create provider, deployment, and route"] },
        { "name": "Send and recover", "scenarioNames": ["CLI-GUI-032 happy", "CLI-GUI-032 limit", "CLI-GUI-032 error"], "stepNames": ["Resolve route, send twice, and inspect Attempt history"] }
      ]
    }
  ],
  "endpoints": [
    { "name": "Resolve session route", "method": "POST", "path": "/api/sessions/:id/model-route/resolve", "priority": "P1", "branches": ["happy", "limit", "error", "flow"], "preconditions": ["Chat session exists"], "expectedResults": ["UI renders server-resolved route and exclusions", "Fixed-once selection is not persisted"], "relatedRule": "ui.server-fact-only-routing" },
    { "name": "Read execution history", "method": "GET", "path": "/api/sessions/:id/execution-tasks", "priority": "P1", "branches": ["happy", "limit", "error", "flow"], "preconditions": ["Session exists"], "expectedResults": ["Refresh restores task and attempt facts without duplicates"], "relatedRule": "ui.recovery-from-persisted-facts" }
  ],
  "scenarios": [
    { "name": "CLI-GUI-032 happy", "priority": "P1", "branches": ["happy", "flow"], "preconditions": ["Server resources and a chat session exist"], "expectedResults": ["Provider, deployment, route, resolved summary, send, and timeline are usable"], "steps": ["Configure route", "Send primary request", "Inspect completed timeline"] },
    { "name": "CLI-GUI-032 limit", "priority": "P1", "branches": ["limit"], "preconditions": ["Long names, eight candidates, and fixed-once selection are used"], "expectedResults": ["Ordering, wrapping, focus, and second-send inheritance remain stable"], "steps": ["Reorder candidates", "Send fixed request", "Send inherited request"] },
    { "name": "CLI-GUI-032 error", "priority": "P1", "branches": ["error"], "preconditions": ["Route load, unavailable fixed target, side effect, or cancel failure is injected"], "expectedResults": ["Stable failure state and actionable recovery are shown; forbidden fallback is absent"], "steps": ["Inject failure", "Inspect dialog/timeline", "Refresh history"] },
    { "name": "CLI-GUI-032 browser", "priority": "P1", "branches": ["flow"], "preconditions": ["Chrome is available at the target viewport"], "expectedResults": ["EN/ZH, keyboard, 1280/900/640, focus restore, and no-overflow checks pass"], "steps": ["Run browser journey", "Capture screenshot and trace"] }
  ],
  "standardRequirements": [
    { "id": "std.p1.unit.routing-ui", "layer": "unit", "appliesTo": ["Configure route"], "requiredFor": ["P1"], "ownerAgent": "unit-test-agent", "requiredEvidence": ["trace"], "gateImpact": "blocking" },
    { "id": "std.p1.api.routing-ui-contract", "layer": "api", "appliesTo": ["POST /api/sessions/:id/model-route/resolve", "GET /api/sessions/:id/execution-tasks"], "requiredFor": ["P1"], "ownerAgent": "test-editor", "requiredEvidence": ["trace"], "gateImpact": "blocking" },
    { "id": "std.p1.e2e.routing-journey", "layer": "e2e", "appliesTo": ["CLI-GUI-032 browser"], "requiredFor": ["P1"], "ownerAgent": "playwright-test-agent", "requiredEvidence": ["trace", "screenshot"], "gateImpact": "blocking" },
    { "id": "std.p1.security.ui-secret-free", "layer": "security", "appliesTo": ["CLI-GUI-032 error"], "requiredFor": ["P1"], "ownerAgent": "test-editor", "requiredEvidence": ["raw-report"], "gateImpact": "blocking" }
  ],
  "releaseGates": [
    { "id": "cli-gui-032-verification", "type": "change-verification", "requiredTestTypes": ["unit", "api", "scenario", "security"], "blocking": true, "evidenceRequired": ["trace", "screenshot"] }
  ],
