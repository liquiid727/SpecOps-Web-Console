  "flows": [
    {
      "name": "Automatic model sync",
      "stages": [
        { "name": "Capability probe", "scenarioNames": ["CLI-GUI-026 happy", "CLI-GUI-026 limit", "CLI-GUI-026 error", "CLI-GUI-026 flow"], "stepNames": ["Resolve profile capabilities"] },
        { "name": "Persist model cache", "scenarioNames": ["CLI-GUI-026 happy", "CLI-GUI-026 error"], "stepNames": ["Read configured models and preserve prior cache on failure"] }
      ]
    }
  ],
  "endpoints": [
    { "name": "Resolve profile capabilities", "method": "GET", "path": "/api/profiles/:id/capabilities", "priority": "P1", "branches": ["happy", "limit", "error", "flow"], "preconditions": ["Profile exists"], "expectedResults": ["Configured models are merged", "TTL suppresses duplicate reads", "Read failure preserves the prior cache"], "relatedRule": "model-sync.auto-read-only" },
    { "name": "Manual model sync", "method": "POST", "path": "/api/profiles/:id/models/sync", "priority": "P1", "branches": ["happy", "limit", "error", "flow"], "preconditions": ["Profile exists"], "expectedResults": ["Manual sync bypasses the automatic TTL"], "relatedRule": "model-sync.manual-overrides-ttl" }
  ],
  "scenarios": [
    { "name": "CLI-GUI-026 happy", "priority": "P1", "branches": ["happy", "flow"], "preconditions": ["Valid Codex/Claude configuration exists"], "expectedResults": ["Models are parsed and persisted"], "steps": ["Probe capabilities", "Inspect merged models"] },
    { "name": "CLI-GUI-026 limit", "priority": "P1", "branches": ["limit"], "preconditions": ["The same profile is probed inside the TTL"], "expectedResults": ["At most one read occurs"], "steps": ["Probe twice", "Count reads"] },
    { "name": "CLI-GUI-026 error", "priority": "P1", "branches": ["error"], "preconditions": ["Configuration is missing or malformed"], "expectedResults": ["Capability resolution remains available and prior models remain"], "steps": ["Probe with a failing reader", "Inspect state and feedback"] },
    { "name": "CLI-GUI-026 flow", "priority": "P1", "branches": ["flow"], "preconditions": ["A profile is selected"], "expectedResults": ["Default ordering and provider ownership remain stable"], "steps": ["Resolve capabilities", "Merge builtin, synced, and custom models"] }
  ],
  "standardRequirements": [
